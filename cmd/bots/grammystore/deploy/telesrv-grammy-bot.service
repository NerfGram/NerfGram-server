[Unit]
Description=Telesrv grammY store and authentication bot
After=network-online.target gramsrv.service
Wants=network-online.target

[Service]
Type=simple
User=telesrv-bot
Group=telesrv-bot
WorkingDirectory=/opt/gramsrv-grammy-bot
EnvironmentFile=/etc/telesrv-grammy-bot.env
ExecStart=/usr/bin/node /opt/gramsrv-grammy-bot/src/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gramsrv-grammy-bot

[Install]
WantedBy=multi-user.target
